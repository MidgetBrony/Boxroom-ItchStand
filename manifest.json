{
  "schemaVersion": 1,
  "id": "boxroom-itch-stand",
  "name": "The Itch Stand",
  "author": "Rusty",
  "description": "A configurable, refreshable rental-style stand for discovering itch.io games with native inspect-only cases.",
  "repository": "https://github.com/MidgetBrony/Boxroom-ItchStand",
  "requirements": { "melonLoader": "0.7.0" },
  "dependencies": [
    {
      "manifest": "https://raw.githubusercontent.com/MidgetBrony/ModsPanel/refs/heads/master/manifest.json",
      "minimumVersion": "2.4.2",
      "required": true
    }
  ],
  "release": {
    "provider": "github",
    "asset": "Boxroom-ItchStand-*.zip",
    "checksumAsset": "SHA256SUMS.txt",
    "destination": "Mods"
  }
}

